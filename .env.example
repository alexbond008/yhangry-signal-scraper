# ─────────────────────────────────────────────────────────────────────────────
# Yhangry Signal Scraper — API Keys
# Copy this file to .env and fill in the values you have.
# All keys are optional — the pipeline degrades gracefully without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Layer 1: Discovery ────────────────────────────────────────────────────────
# Google Places API (New)
# Free tier: 5,000 Text Search requests/month (requires Google Cloud account)
# Get key: https://console.cloud.google.com → Maps Platform → Credentials
# Without this: falls back to DuckDuckGo search (noisier results)
GOOGLE_PLACES_API_KEY=

# ── Layer 3a: Company Verification ───────────────────────────────────────────
# Companies House API (UK)
# Free forever, no credit card, 600 req/5min
# Register: https://developer.company-information.service.gov.uk/
# Without this: company verification step is skipped
COMPANIES_HOUSE_API_KEY=

# ── Layer 3b: Signal Extraction ───────────────────────────────────────────────
# Groq API (LLM extraction — Llama 3.1 8B)
# Free: 14,400 requests/day, no credit card needed
# Register: https://console.groq.com
# Without this: falls back to keyword regex matching
GROQ_API_KEY=
